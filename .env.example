# Rúnir Service — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit credentials.

# ---------------------------------------------------------------------------
# SurrealDB (required)
# ---------------------------------------------------------------------------
SURREAL_URL=http://localhost:8000
SURREAL_USER=root
SURREAL_PASS=
SURREAL_NS=main
SURREAL_DB=main

# ---------------------------------------------------------------------------
# Embedder — Ollama (local dev default)
# ---------------------------------------------------------------------------
EMBEDDER_BASE_URL=http://localhost:11434
EMBEDDER_MODEL=nomic-embed-text:v1.5

# For cloud deployment, switch to Nomic API (MIM-17):
# EMBEDDINGS_PROVIDER=nomic
# EMBEDDER_BASE_URL=https://api-atlas.nomic.ai/v1
# EMBEDDER_MODEL=nomic-embed-text-v1.5
# NOMIC_API_KEY=

# ---------------------------------------------------------------------------
# LLM for capture extraction (required for /hooks/capture and /hooks/session-end)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...
# EXTRACT_MODEL=vertex/gemini-3.1-flash-lite@us  # capture-only override; also the code default
# RUNIR_EXTRACTOR_MODEL=       # legacy shared fallback; can affect other LLM lanes
# EXTRACT_TIMEOUT_MS=30000
# EXTRACT_MAX_CHARS=40000

# ---------------------------------------------------------------------------
# LLM for explicit cited-answer synthesis (/memory/think)
# ---------------------------------------------------------------------------
# RUNIR_THINK_MODEL=openai/gpt-5.6-luna  # also the code default; no reasoning parameter sent

# ---------------------------------------------------------------------------
# Confidence gate (MIM-35)
# ---------------------------------------------------------------------------
# CONFIDENCE_THRESHOLD=0.7    # minimum fact confidence to store

# ---------------------------------------------------------------------------
# Service config (optional — defaults shown)
# ---------------------------------------------------------------------------
PORT=7700
RUNIR_API_KEY=
RUNIR_USER_ID=default
RUNIR_TOP_K=5
RUNIR_AUTO_RECALL=true
RUNIR_AUTO_CAPTURE=true

# Single-tenant mode — all requests must use this userId
# RUNIR_SINGLE_TENANT=

# ---------------------------------------------------------------------------
# Reranker (optional)
# ---------------------------------------------------------------------------
# RERANKER_PROVIDER=off        # off | local | llm (default: local)
# RERANKER_MODEL=              # llm provider only (e.g. google/gemini-flash-1.5)
# RERANKER_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Enrichment + synthesis pipeline
# ---------------------------------------------------------------------------
# ENRICH_BATCH_SIZE=
# ENRICH_MODEL=
# ENRICH_MAX_RETRIES=
# ENRICH_RETRY_DELAY_MS=
# SYNTHESIS_MODEL=
# SYNTHESIS_MIN_CLUSTER_SIZE=
# SYNTHESIS_MIN_NEW_MEMORIES=

# ---------------------------------------------------------------------------
# Consolidation
# ---------------------------------------------------------------------------
# CONSOLIDATION_LOCK_TTL_S=300
# CONSOLIDATION_MIN_SESSIONS=5
# CONSOLIDATION_MIN_HOURS=24

# ---------------------------------------------------------------------------
# Compaction
# ---------------------------------------------------------------------------
# COMPACTION_ENABLED=
# COMPACTION_SIMILARITY_THRESHOLD=
# COMPACTION_COOLDOWN_HOURS=

# ---------------------------------------------------------------------------
# Vault export (MIM-26)
# ---------------------------------------------------------------------------
# VAULT_EXPORT_PATH=

# ---------------------------------------------------------------------------
# Maintenance (MIM-70)
# ---------------------------------------------------------------------------
# MAINTENANCE_SECRET=          # required for POST /hooks/maintenance

# ---------------------------------------------------------------------------
# Debug (dev only)
# ---------------------------------------------------------------------------
# RUNIR_DEBUG=1                # enables POST /debug/ping

# --- zed-01 required config (see docs/zed-01-beta-scope.md) ---
# Calibrated prod relevance floor; code default 0 = relevance gate OFF
RUNIR_RECALL_RELEVANCE_FLOOR=0.55
# Bind address; default loopback. Set 0.0.0.0 to expose beyond loopback — set RUNIR_API_KEY first
RUNIR_HOST=127.0.0.1
# Vault export target for GET /admin/export (owner-ops surface, out of beta scope; endpoint 503s when unset)
# VAULT_EXPORT_PATH=
