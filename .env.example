# Rúnir Service — Environment Variables
# Copy this file to .env and fill in your values.
# .env and every .env.* variant (backups, .local) are gitignored; only this
# template is tracked. Never commit credentials.
#
# The Pi plugin (plugins/runir-pi) reads RUNIR_USER_ID and RUNIR_API_KEY from
# this file too, after its own process environment. Override its path with
# RUNIR_ENV_FILE (default ~/Code/runir/.env).

# ---------------------------------------------------------------------------
# SurrealDB (required)
# ---------------------------------------------------------------------------
SURREAL_URL=http://localhost:8000
SURREAL_USER=root
SURREAL_PASS=
SURREAL_NS=main
SURREAL_DB=main

# ---------------------------------------------------------------------------
# Embedder — Ollama (local dev default)
# ---------------------------------------------------------------------------
EMBEDDER_BASE_URL=http://localhost:11434
EMBEDDER_MODEL=nomic-embed-text:v1.5
# OLLAMA_HOST=                 # takes precedence over EMBEDDER_BASE_URL when set

# For cloud deployment, switch to Nomic API (MIM-17). The Nomic provider uses
# its own fixed endpoint, so no base URL is needed:
# EMBEDDINGS_PROVIDER=nomic    # ollama (default) | nomic | llamacpp
# EMBEDDER_MODEL=nomic-embed-text-v1.5
# NOMIC_API_KEY=

# ---------------------------------------------------------------------------
# LLM for capture extraction (required for /hooks/capture and /hooks/session-end)
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY is sent to RUNIR_LLM_BASE_URL. That is OpenRouter by
# default; point it at any OpenAI-compatible gateway and put that gateway's
# key here. Without a key, /hooks/capture answers 503 (retryable) and the
# consolidation scheduler does not start.
OPENROUTER_API_KEY=
# RUNIR_LLM_BASE_URL=https://openrouter.ai/api/v1
# RUNIR_LLM_TIMEOUT_MS=30000
# EXTRACT_MODEL=vertex/gemini-3.1-flash-lite@us  # capture-only override; also the code default
# RUNIR_EXTRACTOR_MODEL=       # legacy shared fallback; can affect other LLM lanes
# EXTRACT_TIMEOUT_MS=30000
# EXTRACT_MAX_CHARS=40000

# ---------------------------------------------------------------------------
# LLM for explicit cited-answer synthesis (/memory/think)
# ---------------------------------------------------------------------------
# RUNIR_THINK_MODEL=openai/gpt-5.6-luna  # also the code default; no reasoning parameter sent

# ---------------------------------------------------------------------------
# Confidence gate (MIM-35)
# ---------------------------------------------------------------------------
# CONFIDENCE_THRESHOLD=0.7    # minimum fact confidence to store

# ---------------------------------------------------------------------------
# Service config (optional — defaults shown)
# ---------------------------------------------------------------------------
PORT=7700
# Bearer token for the hook endpoints. Without one the service accepts
# unauthenticated requests unless RUNIR_REQUIRE_API_KEY=1 or
# NODE_ENV=production, which make it refuse them.
RUNIR_API_KEY=
# RUNIR_REQUIRE_API_KEY=1
# Your tenant id. The service falls back to "default" when unset; the Pi
# plugin has no fallback, so keep this line and use the same id in every client.
RUNIR_USER_ID=default
RUNIR_TOP_K=5
RUNIR_AUTO_RECALL=true
RUNIR_AUTO_CAPTURE=true

# Single-tenant mode — all requests must use this userId
# RUNIR_SINGLE_TENANT=

# ---------------------------------------------------------------------------
# Reranker (optional)
# ---------------------------------------------------------------------------
# RERANKER_PROVIDER=off        # off | local | llm (default: local)
# RERANKER_MODEL=              # llm provider only (default: google/gemini-2.5-flash-lite)
# RERANKER_TIMEOUT_MS=5000     # default 5000, capped by the recall budget

# ---------------------------------------------------------------------------
# Enrichment + synthesis pipeline
# ---------------------------------------------------------------------------
# Defaults shown; the models are sent to RUNIR_LLM_BASE_URL.
# ENRICH_BATCH_SIZE=50
# ENRICH_MODEL=vertex/gemini-3.1-flash-lite@us   # also the entity alias model
# ENRICH_MAX_RETRIES=3
# ENRICH_RETRY_DELAY_MS=1000
# SYNTHESIS_MODEL=vertex/gemini-3.1-flash-lite@us
# SYNTHESIS_MIN_CLUSTER_SIZE=4
# SYNTHESIS_MIN_NEW_MEMORIES=3

# ---------------------------------------------------------------------------
# Consolidation
# ---------------------------------------------------------------------------
# CONSOLIDATION_LOCK_TTL_S=300
# CONSOLIDATION_MIN_SESSIONS=5
# CONSOLIDATION_MIN_HOURS=24

# ---------------------------------------------------------------------------
# Compaction
# ---------------------------------------------------------------------------
# COMPACTION_ENABLED=true      # default off; any value except "false" turns it on
# COMPACTION_SIMILARITY_THRESHOLD=0.88
# COMPACTION_COOLDOWN_HOURS=24

# ---------------------------------------------------------------------------
# Vault export (MIM-26)
# ---------------------------------------------------------------------------
# VAULT_EXPORT_PATH=           # unset by default: vault export is off

# ---------------------------------------------------------------------------
# Maintenance (MIM-70)
# ---------------------------------------------------------------------------
# MAINTENANCE_SECRET=          # required for POST /hooks/maintenance
# RUNIR_EVIDENCE_SECRET=       # bearer for POST /hooks/evidence and /hooks/enroll; both refuse requests when unset

# ---------------------------------------------------------------------------
# Source layer (optional; see scripts/source-layer/README.md)
# ---------------------------------------------------------------------------
# RUNIR_SOURCE_STORE=on        # store verbatim source turns (default off)
# RUNIR_SOURCE_HMAC_KEY=       # required when the source store or source recall is on
# RUNIR_SOURCE_RECALL=shadow   # off (default) | shadow | on: read source excerpts at recall
# RUNIR_SOURCE_EXACT_QA_TOP_N=20   # exact-QA hits that get source excerpts; default 20, max 50
# RUNIR_SOURCE_SPOOL_DIR=      # default ~/Library/Application Support/Runir/source-spool

# ---------------------------------------------------------------------------
# Ranking and nightly jobs (optional)
# ---------------------------------------------------------------------------
# RUNIR_RANKING_PROFILES=      # path to a per-tenant ranking profiles file; unset = no profiles
# RUNIR_LANGEXTRACT_SWEEP=1    # opt-in nightly entity sweep (needs its Python venv)

# ---------------------------------------------------------------------------
# Debug (dev only)
# ---------------------------------------------------------------------------
# RUNIR_DEBUG=1                # enables POST /debug/ping

# --- zed-01 required config (see docs/zed-01-beta-scope.md) ---
# Calibrated prod relevance floor; code default 0 = relevance gate OFF
RUNIR_RECALL_RELEVANCE_FLOOR=0.55
# Bind address; default loopback. Set 0.0.0.0 to expose beyond loopback — set RUNIR_API_KEY first
RUNIR_HOST=127.0.0.1
# VAULT_EXPORT_PATH (above) is also the GET /admin/export target; that endpoint 503s when unset
