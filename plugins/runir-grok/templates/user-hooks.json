{
  "description": "Native R\u00fanir lifecycle hooks for Grok.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env __ENV_WIRING__python3 \"__PLUGIN_ROOT__/hooks/runir-grok.py\"",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env __ENV_WIRING__python3 \"__PLUGIN_ROOT__/hooks/runir-grok.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env __ENV_WIRING__python3 \"__PLUGIN_ROOT__/hooks/runir-grok.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
